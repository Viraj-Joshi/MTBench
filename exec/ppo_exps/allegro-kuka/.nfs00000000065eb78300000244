#!/bin/bash
# Multi-task Allegro-Kuka (regrasping / throw / reorientation) via MTBench rl_games PPO.
# Run from the MTBench repo root:  bash exec/ppo_exps/allegro-kuka/vanilla.sh
#
# task ids:  0 -> regrasping, 1 -> throw, 2 -> reorientation
task_ids="[0,1,2]"
num_tasks=3

for e in 24576
do
	# split e envs across tasks; first `rem` tasks get one extra (sums to e)
	base=$(( e / num_tasks ))
	rem=$(( e % num_tasks ))
	counts=()
	for ((k=0; k<num_tasks; k++)); do
		if [ $k -lt $rem ]; then counts+=($((base + 1))); else counts+=($base); fi
	done
	task_counts="[$(IFS=,; echo "${counts[*]}")]"

	# ~2e10 env steps total
	t=$(( (20000000000 + (e * 16) - 1) / (e * 16) ))

	for i in 42
	do
		cmd="python isaacgymenvs/train.py \
			task=AllegroKukaMT \
			task_id=$task_ids \
			task_counts=$task_counts \
			num_envs=$e \
			train=meta-world-mt10-vanilla-asymmetric-lstm-PPO \
			train.params.config.learning_rate=3e-4 \
			train.params.config.entropy_coef=0.001 \
			train.params.network.separate=False \
			experiment=ppo_vanilla_allegro-kuka_mt_shared_lstm_adaptive-lr-3e-4_mb_16384_ent_0p001_${e}_seed_${i} \
			seed=$i \
			wandb_activate=True \
			wandb_project=reppo \
			sim_device=cuda:1 \
			rl_device=cuda:1 \
			headless=True \
			capture_video=False \
			max_iterations=$t"
		echo $cmd
		$cmd
	done
done
